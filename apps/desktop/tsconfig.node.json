{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "types": ["node"],
    "composite": true,
    "noEmit": true
  },
  "include": [
    "electron.vite.config.ts",
    "src/backend/**/*.ts",
    "src/bridge/**/*.ts",
    "src/shared/**/*.ts",
    "tests/backend/**/*.ts",
    "tests/bridge/**/*.ts"
  ]
}
